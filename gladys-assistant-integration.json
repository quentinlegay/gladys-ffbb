{
  "manifest_version": 1,
  "type": "device",
  "name": "FFBB Basket",
  "description": {
    "en": "Follow French basketball teams: Betclic ELITE, ELITE 2, Nationale… live scores.",
    "fr": "Suivez vos équipes de basket : Betclic ELITE, ELITE 2, Nationale… scores en direct."
  },
  "version": "0.1.1",
  "docker_image": "ghcr.io/quentinlegay/gladys-ffbb:0.1.1",
  "gladys_version": ">=5.3.0",
  "cover_image": "https://raw.githubusercontent.com/quentinlegay/gladys-ffbb/main/cover.png",
  "categories": ["leisure", "services"],
  "keywords": [
    "basket",
    "basketball",
    "ffbb",
    "lnb",
    "betclic elite",
    "pro a",
    "pro b",
    "elite 2",
    "nationale 1",
    "lfb"
  ],
  "transports": ["cloud"],
  "config_schema": [
    {
      "key": "intro",
      "type": "section",
      "label": {
        "en": "Getting started",
        "fr": "Pour commencer"
      },
      "description": {
        "en": "Fixtures and live scores come from the public API of the French basketball federation (FFBB), the one behind its official app: no account, no key. Write the teams to follow as COMPETITION:TEAM, separated by commas, e.g. ELITE:Monaco, ELITE2:Nancy, NM1:Saint-Quentin. Not sure of the name? Use the \"Find a team\" button below. Each team becomes a device in the Discover tab.",
        "fr": "Le calendrier et les scores en direct viennent de l'API publique de la Fédération française de basket-ball (FFBB), celle de son application officielle : pas de compte, pas de clé. Écrivez les équipes à suivre sous la forme COMPÉTITION:ÉQUIPE, séparées par des virgules, par ex. ELITE:Monaco, ELITE2:Nancy, NM1:Saint-Quentin. Pas sûr du nom ? Utilisez le bouton « Trouver une équipe » plus bas. Chaque équipe devient un appareil dans l'onglet Découverte."
      },
      "links": [
        {
          "url": "https://github.com/quentinlegay/gladys-ffbb/blob/main/docs/en.md#competitions",
          "label": {
            "en": "Competition codes",
            "fr": "Codes des compétitions"
          }
        }
      ]
    },
    {
      "key": "teams",
      "type": "string",
      "label": {
        "en": "Teams",
        "fr": "Équipes"
      },
      "description": {
        "en": "COMPETITION:TEAM entries separated by commas (20 at most). The team is its name, a word of it, or its FFBB club id.",
        "fr": "Entrées COMPÉTITION:ÉQUIPE séparées par des virgules (20 au plus). L'équipe est son nom, un mot de son nom, ou son identifiant de club FFBB."
      },
      "placeholder": {
        "en": "e.g. ELITE:Monaco, NM1:Saint-Quentin",
        "fr": "ex. ELITE:Monaco, NM1:Saint-Quentin"
      },
      "required": true
    },
    {
      "key": "language",
      "type": "select",
      "label": {
        "en": "Language of the game texts",
        "fr": "Langue des textes de match"
      },
      "description": {
        "en": "Language of the \"Game\" text shown on the devices and sent to the scenes.",
        "fr": "Langue du texte « Match » affiché sur les appareils et envoyé aux scènes."
      },
      "required": false,
      "default": "fr",
      "display": "radio",
      "options": [
        {
          "value": "en",
          "label": {
            "en": "English",
            "fr": "Anglais"
          }
        },
        {
          "value": "fr",
          "label": {
            "en": "French",
            "fr": "Français"
          }
        }
      ]
    },
    {
      "key": "timezone",
      "type": "string",
      "label": {
        "en": "Time zone",
        "fr": "Fuseau horaire"
      },
      "description": {
        "en": "Tip-off times are written in this time zone (IANA name).",
        "fr": "Les heures de coup d'envoi sont écrites dans ce fuseau (nom IANA)."
      },
      "placeholder": {
        "en": "e.g. Europe/Paris",
        "fr": "ex. Europe/Paris"
      },
      "required": false,
      "default": "Europe/Paris"
    },
    {
      "key": "reminder_minutes",
      "type": "number",
      "label": {
        "en": "Tip-off reminder (min)",
        "fr": "Rappel avant le coup d'envoi (min)"
      },
      "description": {
        "en": "The \"Game starting soon\" trigger fires this many minutes before tip-off. 0 turns it off.",
        "fr": "Le déclencheur « Match bientôt » part ce nombre de minutes avant le coup d'envoi. 0 le désactive."
      },
      "required": false,
      "default": 30,
      "min": 0,
      "max": 1440
    },
    {
      "key": "live_refresh",
      "type": "number",
      "label": {
        "en": "Refresh during a game (s)",
        "fr": "Actualisation pendant un match (s)"
      },
      "description": {
        "en": "How often scores are read while a game is live, in seconds.",
        "fr": "Fréquence de lecture des scores pendant un match, en secondes."
      },
      "required": false,
      "default": 30,
      "min": 15,
      "max": 300
    },
    {
      "key": "idle_refresh",
      "type": "number",
      "label": {
        "en": "Refresh between games (min)",
        "fr": "Actualisation entre les matchs (min)"
      },
      "description": {
        "en": "How often the next games are checked when nothing is live, in minutes.",
        "fr": "Fréquence de vérification des prochains matchs quand rien n'est en direct, en minutes."
      },
      "required": false,
      "default": 15,
      "min": 5,
      "max": 120
    }
  ],
  "actions": [
    {
      "key": "test_teams",
      "label": {
        "en": "Test the teams",
        "fr": "Tester les équipes"
      },
      "description": {
        "en": "Read the FFBB now and show, team by team, what is followed.",
        "fr": "Lit la FFBB maintenant et montre, équipe par équipe, ce qui est suivi."
      },
      "timeout_seconds": 60
    },
    {
      "key": "find_team",
