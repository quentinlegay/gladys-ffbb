{
  "manifest_version": 1,
  "type": "device",
  "name": "Eco Bike",
  "description": {
    "en": "CO₂ avoided and money saved by riding instead of driving, from your Strava trips.",
    "fr": "CO₂ évité et argent économisé en vélo plutôt qu’en voiture, d’après vos trajets Strava."
  },
  "version": "0.1.0",
  "docker_image": "ghcr.io/quentinlegay/gladys-eco-bike:0.1.0",
  "gladys_version": ">=5.3.0",
  "cover_image": "https://raw.githubusercontent.com/quentinlegay/gladys-eco-bike/main/cover.png",
  "categories": ["environment", "services"],
  "keywords": [
    "strava",
    "bike",
    "vélo",
    "cycling",
    "commute",
    "vélotaf",
    "co2",
    "carbon",
    "fuel",
    "carburant"
  ],
  "transports": ["cloud"],
  "location": true,
  "config_schema": [
    {
      "key": "intro",
      "type": "section",
      "label": {
        "en": "Getting started",
        "fr": "Pour commencer"
      },
      "description": {
        "en": "Every trip you ride instead of driving saves CO₂ and money. The integration reads your activities on Strava and values each kilometre with the car you would have taken and the fuel price of the station nearest to your home (French government open data). 1. Create a Strava API application, with the domain of your Gladys as \"Authorization Callback Domain\". 2. Paste its client ID and secret below and save. 3. Click Connect.",
        "fr": "Chaque trajet fait à vélo plutôt qu’en voiture évite du CO₂ et économise de l’argent. L’intégration lit vos activités Strava et valorise chaque kilomètre avec la voiture que vous auriez prise et le prix du carburant de la station la plus proche de chez vous (données ouvertes du gouvernement). 1. Créez une application API Strava, avec le domaine de votre Gladys comme « Authorization Callback Domain ». 2. Collez son ID client et son secret ci-dessous et enregistrez. 3. Cliquez sur Connecter."
      },
      "links": [
        {
          "url": "https://www.strava.com/settings/api",
          "label": {
            "en": "Strava API applications",
            "fr": "Applications API Strava"
          }
        },
        {
          "url": "https://github.com/quentinlegay/gladys-eco-bike/blob/main/docs/en.md#create-a-strava-application",
          "label": {
            "en": "Step by step",
            "fr": "Pas à pas"
          }
        }
      ]
    },
    {
      "key": "client_id",
      "type": "string",
      "label": {
        "en": "Strava client ID",
        "fr": "ID client Strava"
      },
      "description": {
        "en": "The \"Client ID\" of your Strava API application.",
        "fr": "Le « Client ID » de votre application API Strava."
      },
      "placeholder": {
        "en": "e.g. 123456",
        "fr": "ex. 123456"
      },
      "required": true
    },
    {
      "key": "client_secret",
      "type": "secret",
      "label": {
        "en": "Strava client secret",
        "fr": "Secret client Strava"
      },
      "description": {
        "en": "The \"Client Secret\" of your Strava API application.",
        "fr": "Le « Client Secret » de votre application API Strava."
      },
      "required": true
    },
    {
      "key": "strava",
      "type": "oauth2",
      "label": {
        "en": "Strava account",
        "fr": "Compte Strava"
      },
      "description": {
        "en": "Save the client ID and secret first. The integration only reads your activities.",
        "fr": "Enregistrez d’abord l’ID client et le secret. L’intégration ne fait que lire vos activités."
      }
    },
    {
      "key": "trips",
      "type": "section",
      "label": {
        "en": "Trips counted",
        "fr": "Trajets comptés"
      },
      "description": {
        "en": "A trip counts when it replaced a car journey. Tag your daily trips as \"Commute\" in Strava (a checkbox of the activity, or of the bike in your gear) and keep the default, or count every ride.",
        "fr": "Un trajet compte quand il a remplacé un trajet en voiture. Marquez vos trajets du quotidien « Trajet domicile-travail » dans Strava (une case de l’activité, ou du vélo dans votre matériel) et gardez le réglage par défaut, ou comptez toutes les sorties."
      }
    },
    {
      "key": "activities",
      "type": "select",
      "label": {
        "en": "Activities counted",
        "fr": "Activités comptées"
      },
      "required": false,
      "default": "commute",
      "display": "radio",
      "options": [
        {
          "value": "commute",
          "label": {
            "en": "Only those tagged \"Commute\"",
            "fr": "Seulement celles marquées « Trajet domicile-travail »"
          }
        },
        {
          "value": "all",
          "label": {
            "en": "Every activity",
            "fr": "Toutes les activités"
          }
        }
      ]
    },
    {
      "key": "sports",
      "type": "select",
      "label": {
        "en": "Sports",
        "fr": "Sports"
      },
      "required": false,
      "default": "bike",
      "display": "radio",
      "options": [
        {
          "value": "bike",
          "label": {
            "en": "Bike (including e-bike)",
            "fr": "Vélo (électrique compris)"
          }
        },
        {
          "value": "bike_foot",
          "label": {
            "en": "Bike, walk and run",
            "fr": "Vélo, marche et course"
          }
        }
      ]
    },
    {
      "key": "start_date",
      "type": "string",
      "label": {
        "en": "Count from",
        "fr": "Compter à partir du"
      },
      "description": {
        "en": "Date of the first trip counted (YYYY-MM-DD). Empty: the whole Strava history.",
        "fr": "Date du premier trajet compté (AAAA-MM-JJ). Vide : tout l’historique Strava."
      },
      "placeholder": {
        "en": "e.g. 2026-01-01",
        "fr": "ex. 2026-01-01"
      },
      "required": false,
      "default": ""
    },
    {
      "key": "vehicle",
      "type": "section",
      "label": {
        "en": "Compared vehicle",
        "fr": "Véhicule comparé"
      },
      "description": {
        "en": "The car you would have taken. Its consumption is on its registration papers or in its manual; the CO₂ is estimated from it, or write the figure you know.",
        "fr": "La voiture que vous auriez prise. Sa consommation figure dans sa documentation ; le CO₂ en est estimé, ou écrivez la valeur que vous connaissez."
      }
    },
    {
      "key": "vehicle_name",
      "type": "string",
      "label": {
        "en": "Vehicle name",
        "fr": "Nom du véhicule"
      },
      "placeholder": {
        "en": "e.g. Clio",
        "fr": "ex. Clio"
      },
      "required": false,
      "default": ""
    },
    {
      "key": "fuel_type",
      "type": "select",
      "label": {
        "en": "Energy",
        "fr": "Énergie"
      },
      "required": false,
      "default": "gazole",
      "options": [
        {
          "value": "gazole",
          "label": {
            "en": "Diesel",
            "fr": "Gazole"
          }
        },
        {
          "value": "sp95",
          "label": {
            "en": "Unleaded 95",
            "fr": "SP95"
          }
        },
        {
          "value": "e10",
          "label": {
            "en": "Unleaded 95-E10",
            "fr": "SP95-E10"
          }
        },
        {
          "value": "sp98",
          "label": {
            "en": "Unleaded 98",
            "fr": "SP98"
          }
        },
        {
          "value": "e85",
          "label": {
            "en": "E85 bioethanol",
            "fr": "Superéthanol E85"
          }
        },
        {
          "value": "gplc",
          "label": {
            "en": "LPG",
            "fr": "GPL"
          }
        },
        {
          "value": "electric",
          "label": {
            "en": "Electric",
            "fr": "Électrique"
          }
        }
      ]
    },
    {
      "key": "consumption",
      "type": "number",
      "label": {
        "en": "Consumption (L or kWh / 100 km)",
        "fr": "Consommation (L ou kWh / 100 km)"
      },
      "description": {
        "en": "Litres per 100 km, or kWh per 100 km for an electric car.",
        "fr": "Litres aux 100 km, ou kWh aux 100 km pour une voiture électrique."
      },
      "required": false,
      "default": 6.5,
      "min": 0.1,
      "max": 100
    },
    {
      "key": "co2_per_km",
      "type": "number",
      "label": {
        "en": "CO₂ per km (g)",
        "fr": "CO₂ par km (g)"
      },
      "description": {
        "en": "0: estimated from the consumption and the energy (well-to-wheel ADEME factors).",
        "fr": "0 : estimé d’après la consommation et l’énergie (facteurs ADEME du puits à la roue)."
      },
      "required": false,
      "default": 0,
      "min": 0,
      "max": 1000
    },
    {
      "key": "extra_cost_per_km",
      "type": "number",
      "label": {
        "en": "Other costs per km (€)",
        "fr": "Autres frais par km (€)"
      },
      "description": {
        "en": "Wear, tyres, servicing, parking… added to the fuel for every kilometre ridden. 0: fuel only.",
        "fr": "Usure, pneus, entretien, stationnement… ajoutés au carburant pour chaque kilomètre parcouru. 0 : carburant seul."
      },
      "required": false,
      "default": 0,
      "min": 0,
      "max": 10
    },
    {
      "key": "fuel",
      "type": "section",
      "label": {
        "en": "Fuel price",
        "fr": "Prix du carburant"
      },
      "description": {
        "en": "Read every 6 hours from the station nearest to the house located in Gladys (France only). Each trip is valued at the price of its day.",
        "fr": "Lu toutes les 6 heures à la station la plus proche de la maison localisée dans Gladys (France uniquement). Chaque trajet est valorisé au prix de son jour."
      }
    },
    {
      "key": "house",
      "type": "select",
      "source": "houses",
      "label": {
        "en": "House",
        "fr": "Maison"
      },
      "description": {
        "en": "Empty: the first house located in Gladys.",
        "fr": "Vide : la première maison localisée dans Gladys."
      },
      "required": false
    },
    {
      "key": "station_choice",
      "type": "select",
      "label": {
        "en": "Station",
        "fr": "Station"
      },
      "required": false,
      "default": "nearest",
      "display": "radio",
      "options": [
        {
          "value": "nearest",
          "label": {
            "en": "The nearest one",
            "fr": "La plus proche"
          }
        },
        {
          "value": "cheapest",
          "label": {
            "en": "The cheapest within the radius",
            "fr": "La moins chère dans le rayon"
          }
        }
      ]
    },
    {
      "key": "search_radius",
      "type": "number",
      "label": {
        "en": "Search radius (km)",
        "fr": "Rayon de recherche (km)"
      },
      "required": false,
      "default": 10,
      "min": 1,
      "max": 50
    },
    {
      "key": "fuel_price",
      "type": "number",
      "label": {
        "en": "Fixed price (€ per L or kWh)",
        "fr": "Prix fixe (€ par L ou kWh)"
      },
      "description": {
        "en": "Used instead of the stations when set (abroad, or for an electric car: your price per kWh). 0: the nearest station.",
        "fr": "Utilisé à la place des stations s’il est renseigné (à l’étranger, ou pour une voiture électrique : votre prix du kWh). 0 : la station la plus proche."
      },
      "required": false,
      "default": 0,
      "min": 0,
      "max": 10
    },
    {
      "key": "advanced",
      "type": "section",
      "label": {
        "en": "Display and refresh",
        "fr": "Affichage et actualisation"
      }
    },
    {
      "key": "milestone_kg",
      "type": "number",
      "label": {
        "en": "CO₂ milestone (kg)",
        "fr": "Palier de CO₂ (kg)"
      },
      "description": {
        "en": "The \"CO₂ milestone\" trigger fires every time the CO₂ avoided crosses a multiple of this value. 0 turns it off.",
        "fr": "Le déclencheur « Palier de CO₂ » part chaque fois que le CO₂ évité franchit un multiple de cette valeur. 0 le désactive."
      },
      "required": false,
      "default": 50,
      "min": 0,
      "max": 100000
    },
    {
      "key": "refresh_minutes",
      "type": "number",
      "label": {
        "en": "Strava refresh (min)",
        "fr": "Actualisation Strava (min)"
      },
      "description": {
        "en": "How often new activities are read, in minutes.",
        "fr": "Fréquence de lecture des nouvelles activités, en minutes."
      },
      "required": false,
      "default": 60,
      "min": 15,
      "max": 1440
    },
    {
      "key": "language",
      "type": "select",
      "label": {
        "en": "Language of the texts",
        "fr": "Langue des textes"
      },
      "required": false,
      "default": "fr",
      "display": "radio",
      "options": [
        {
          "value": "en",
          "label": {
            "en": "English",
            "fr": "Anglais"
          }
        },
        {
          "value": "fr",
          "label": {
            "en": "French",
            "fr": "Français"
          }
        }
      ]
    },
    {
      "key": "timezone",
      "type": "string",
      "label": {
        "en": "Time zone",
        "fr": "Fuseau horaire"
      },
      "description": {
        "en": "Decides when a month or a year starts (IANA name).",
        "fr": "Décide quand un mois ou une année commence (nom IANA)."
      },
      "placeholder": {
        "en": "e.g. Europe/Paris",
        "fr": "ex. Europe/Paris"
      },
      "required": false,
      "default": "Europe/Paris"
    }
  ],
  "actions": [
    {
      "key": "test_connection",
      "label": {
        "en": "Test",
        "fr": "Tester"
      },
      "description": {
        "en": "Read Strava and the fuel price now, and show what is counted.",
        "fr": "Lit Strava et le prix du carburant maintenant, et montre ce qui est compté."
      },
      "timeout_seconds": 120
    },
    {
      "key": "resync",
      "label": {
        "en": "Read the whole history again",
        "fr": "Relire tout l’historique"
      },
      "description": {
        "en": "Needed only after editing activities older than a week on Strava.",
        "fr": "Utile seulement après avoir modifié sur Strava des activités de plus d’une semaine."
      },
      "timeout_seconds": 120
    }
  ],
  "scene_triggers": [
    {
      "key": "trip_recorded",
      "label": {
        "en": "Eco trip recorded",
        "fr": "Trajet écolo enregistré"
      },
      "description": {
        "en": "A new trip counted on Strava (one event per trip).",
        "fr": "Un nouveau trajet compté sur Strava (un événement par trajet)."
      },
      "fields": [],
      "variables": [
        {
          "key": "name",
          "type": "string",
          "label": {
            "en": "Activity name",
            "fr": "Nom de l’activité"
          }
        },
        {
          "key": "sport",
          "type": "string",
          "label": {
            "en": "Sport (Strava type)",
            "fr": "Sport (type Strava)"
          }
        },
        {
          "key": "date",
          "type": "string",
          "label": {
            "en": "Start (ISO date)",
            "fr": "Départ (date ISO)"
          }
        },
        {
          "key": "distance_km",
          "type": "number",
          "label": {
            "en": "Distance (km)",
            "fr": "Distance (km)"
          }
        },
        {
          "key": "co2_kg",
          "type": "number",
          "label": {
            "en": "CO₂ avoided (kg)",
            "fr": "CO₂ évité (kg)"
          }
        },
        {
          "key": "money",
          "type": "number",
          "label": {
            "en": "Money saved (€)",
            "fr": "Argent économisé (€)"
          }
        },
        {
          "key": "total_co2_kg",
          "type": "number",
          "label": {
            "en": "Total CO₂ avoided (kg)",
            "fr": "CO₂ évité au total (kg)"
          }
        },
        {
          "key": "total_money",
          "type": "number",
          "label": {
            "en": "Total money saved (€)",
            "fr": "Économisé au total (€)"
          }
        },
        {
          "key": "total_distance_km",
          "type": "number",
          "label": {
            "en": "Total distance (km)",
            "fr": "Distance totale (km)"
          }
        }
      ]
    },
    {
      "key": "co2_milestone",
      "label": {
        "en": "CO₂ milestone",
        "fr": "Palier de CO₂"
      },
      "description": {
        "en": "The total CO₂ avoided crossed a milestone of the configuration.",
        "fr": "Le CO₂ évité au total a franchi un palier de la configuration."
      },
      "fields": [],
      "variables": [
        {
          "key": "milestone_kg",
          "type": "number",
          "label": {
            "en": "Milestone (kg)",
            "fr": "Palier (kg)"
          }
        },
        {
          "key": "total_co2_kg",
          "type": "number",
          "label": {
            "en": "Total CO₂ avoided (kg)",
            "fr": "CO₂ évité au total (kg)"
          }
        },
        {
          "key": "total_money",
          "type": "number",
          "label": {
            "en": "Total money saved (€)",
            "fr": "Économisé au total (€)"
          }
        },
        {
          "key": "total_distance_km",
          "type": "number",
          "label": {
            "en": "Total distance (km)",
            "fr": "Distance totale (km)"
          }
        },
        {
          "key": "trips",
          "type": "number",
          "label": {
            "en": "Trips",
            "fr": "Trajets"
          }
        }
      ]
    }
  ],
  "scene_actions": [
    {
      "key": "get_savings",
      "label": {
        "en": "Get the savings",
        "fr": "Lire les économies"
      },
      "description": {
        "en": "CO₂ avoided, money saved and distance of a period, for the next actions.",
        "fr": "CO₂ évité, argent économisé et distance d’une période, pour les actions suivantes."
      },
      "timeout_seconds": 10,
      "fields": [
        {
          "key": "period",
          "type": "select",
          "label": {
            "en": "Period",
            "fr": "Période"
          },
          "required": false,
          "default": "total",
          "options": [
            {
              "value": "total",
              "label": {
                "en": "Since the start",
                "fr": "Depuis le début"
              }
            },
            {
              "value": "year",
              "label": {
                "en": "This year",
                "fr": "Cette année"
              }
            },
            {
              "value": "month",
              "label": {
                "en": "This month",
                "fr": "Ce mois-ci"
              }
            },
            {
              "value": "week",
              "label": {
                "en": "This week",
                "fr": "Cette semaine"
              }
            }
          ]
        }
      ],
      "outputs": [
        {
          "key": "co2_kg",
          "type": "number",
          "label": {
            "en": "CO₂ avoided (kg)",
            "fr": "CO₂ évité (kg)"
          }
        },
        {
          "key": "money",
          "type": "number",
          "label": {
            "en": "Money saved (€)",
            "fr": "Argent économisé (€)"
          }
        },
        {
          "key": "distance_km",
          "type": "number",
          "label": {
            "en": "Distance (km)",
            "fr": "Distance (km)"
          }
        },
        {
          "key": "trips",
          "type": "number",
          "label": {
            "en": "Trips",
            "fr": "Trajets"
          }
        },
        {
          "key": "fuel_price",
          "type": "number",
          "label": {
            "en": "Fuel price (€)",
            "fr": "Prix du carburant (€)"
          }
        },
        {
          "key": "summary",
          "type": "string",
          "label": {
            "en": "Summary",
            "fr": "Résumé"
          }
        }
      ]
    }
  ],
  "widgets": [
    {
      "key": "savings",
      "label": {
        "en": "Eco Bike savings",
        "fr": "Économies Éco Vélo"
      },
      "description": {
        "en": "CO₂ avoided, money saved, distance and trips, with the last 12 months.",
        "fr": "CO₂ évité, argent économisé, distance et trajets, avec les 12 derniers mois."
      },
      "icon": "wind",
      "settings": [
        {
          "key": "period",
          "type": "select",
          "label": {
            "en": "Period",
            "fr": "Période"
          },
          "required": false,
          "default": "year",
          "options": [
            {
              "value": "total",
              "label": {
                "en": "Since the start",
                "fr": "Depuis le début"
              }
            },
            {
              "value": "year",
              "label": {
                "en": "This year",
                "fr": "Cette année"
              }
            },
            {
              "value": "month",
              "label": {
                "en": "This month",
                "fr": "Ce mois-ci"
              }
            },
            {
              "value": "week",
              "label": {
                "en": "This week",
                "fr": "Cette semaine"
              }
            }
          ]
        },
        {
          "key": "chart",
          "type": "select",
          "label": {
            "en": "Chart",
            "fr": "Graphique"
          },
          "required": false,
          "default": "co2",
          "options": [
            {
              "value": "co2",
              "label": {
                "en": "CO₂ avoided",
                "fr": "CO₂ évité"
              }
            },
            {
              "value": "money",
              "label": {
                "en": "Money saved",
                "fr": "Argent économisé"
              }
            },
            {
              "value": "distance",
              "label": {
                "en": "Distance",
                "fr": "Distance"
              }
            }
          ]
        }
      ],
      "action_timeout_seconds": 120
    },
    {
      "key": "recent_trips",
      "label": {
        "en": "Recent eco trips",
        "fr": "Derniers trajets écolos"
      },
      "description": {
        "en": "The last trips counted, with what each one saved.",
        "fr": "Les derniers trajets comptés, avec ce que chacun a économisé."
      },
      "icon": "list",
      "settings": [
        {
          "key": "count",
          "type": "number",
          "label": {
            "en": "Trips shown",
            "fr": "Trajets affichés"
          },
          "required": false,
          "default": 5,
          "min": 1,
          "max": 8
        }
      ],
      "action_timeout_seconds": 120
    }
  ]
}
